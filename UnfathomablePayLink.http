@baseUrl = https://localhost:7123
@adminApiKey = admin-dev-key
@businessApiKey = testing

### =============================================================
### 1. BUSINESSES CRUD (Admin Only)
### =============================================================

### 1.1 Read All Businesses
GET {{baseUrl}}/api/businesses
X-Api-Key: {{adminApiKey}}
Accept: application/json

### 1.2 Create a Business (ApiKey generated server-side)
POST {{baseUrl}}/api/businesses
X-Api-Key: {{adminApiKey}}
Content-Type: application/json

{
  "name": "Acme Corp",
  "document": "30-12345678-9",
  "webhookUrl": "https://example.com/webhook",
  "invoiceProviderKey": "mock"
}

### 1.3 Read Business by ID
GET {{baseUrl}}/api/businesses/1
X-Api-Key: {{adminApiKey}}
Accept: application/json

### 1.4 Update Business (preserves existing ApiKey)
PUT {{baseUrl}}/api/businesses/1
X-Api-Key: {{adminApiKey}}
Content-Type: application/json

{
  "name": "Acme Corporation Updated",
  "document": "30-12345678-9",
  "webhookUrl": "https://example.com/webhook-updated",
  "invoiceProviderKey": "mock"
}

### 1.5 Delete Business (blocked with 409 if payments exist)
DELETE {{baseUrl}}/api/businesses/4
X-Api-Key: {{adminApiKey}}

### =============================================================
### 2. PAYMENTS (Business Only)
### =============================================================

### 2.1 Read All Payments
GET {{baseUrl}}/api/payments
X-Api-Key: {{businessApiKey}}
Accept: application/json

### 2.2 Create Payment
POST {{baseUrl}}/api/payments
X-Api-Key: {{businessApiKey}}
Content-Type: application/json

{
  "invoiceId": "INV-002"
}

### 2.3 Read Payment by ID
GET {{baseUrl}}/api/payments/1
X-Api-Key: {{businessApiKey}}
Accept: application/json

### =============================================================
### 3. WEBHOOK (Business Only)
### =============================================================

### 3.1 Get Webhook URL
GET {{baseUrl}}/api/webhook
X-Api-Key: {{businessApiKey}}
Accept: application/json

### 3.2 Update Webhook URL
PUT {{baseUrl}}/api/webhook
X-Api-Key: {{businessApiKey}}
Content-Type: application/json

{
  "url": "https://example.com/paylink-webhook"
}

### 3.3 Delete Webhook URL
DELETE {{baseUrl}}/api/webhook
X-Api-Key: {{businessApiKey}}
