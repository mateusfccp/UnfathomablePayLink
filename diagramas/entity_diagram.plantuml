@startuml

entity Businesses {
	* Id : INTEGER <<PK, generated>>
	--
	* Name : TEXT
	* Document : TEXT <<UNIQUE>>
	* ApiKey : TEXT <<UNIQUE>>
	  WebhookUrl : TEXT <<nullable>>
	* InvoiceProviderKey : TEXT <<default: "mock">>
}

entity Payments {
	* Id : INTEGER <<PK, generated>>
	--
	* BusinessId : INTEGER <<FK>>
	* InvoiceId : TEXT
	* Amount : DECIMAL (TEXT in SQLite)
	* State : TEXT <<Approved | Rejected | Pending>>
	  PaymentDate : DATETIME (TEXT, nullable)
}

Payments }o--|| Businesses : "BusinessId (ON DELETE RESTRICT)"

@enduml
